APP_NAME=MindCare AI API
APP_ENV=development
APP_VERSION=2.0.0
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mindcare
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
TRUSTED_HOSTS=localhost,127.0.0.1
